<mvc:View
    controllerName="industriaui.controller.LineDetails"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="lineDetailsPage"
        title="Production Line Details"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <VBox
                id="lineDetailsContainer"
                class="sapUiMediumMargin">

                <Title
                    id="selectedLineTitle"
                    text="Production Line"/>

               
 <ObjectHeader
                    id="lineHeader"
                    title="{production>lineName}"
                    number="{production>produced}"
                    numberUnit="L">
                    <attributes>

                        <ObjectAttribute
                            id="lineSkuAttribute"
                            title="SKU"
                            text="{production>sku}"/>

                        <ObjectAttribute
                            id="lineTargetAttribute"
                            title="Shift Target"
                            text="{production>shiftTarget} L"/>

                    </attributes>

                    <statuses>

                        <ObjectStatus
                            id="lineDetailStatus"
                            text="{production>status}"/>

                    </statuses>
                        </ObjectHeader>
                


                <Panel
    id="productionProgressPanel"
    headerText="Shift Progress"
    class="sapUiMediumMarginTop">

    <VBox
        id="productionProgressContainer"
        class="sapUiMediumMargin">

        <ObjectNumber
            id="progressProduced"
            number="{production>produced}"
            unit="L"/>

        <ProgressIndicator
            id="productionProgress"
            percentValue="{= ${production>produced} / ${production>shiftTarget} * 100 }"
            displayValue="{= ${production>produced} + ' L / ' + ${production>shiftTarget} + ' L' }"
            state="Success"/>

    </VBox>

</Panel>


<Title
    id="incidentsTitle"
    text="Production Incidents"
    level="H2"
    class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>

<Table
    id="incidentsTable"
    items="{production>incidents}"
    noDataText="No incidents reported">

    <columns>

        <Column id="incidentTypeColumn">
            <Text
                id="incidentTypeHeader"
                text="Type"/>
        </Column>

        <Column id="incidentDescriptionColumn">
            <Text
                id="incidentDescriptionHeader"
                text="Issue"/>
        </Column>

        <Column id="incidentStartColumn">
            <Text
                id="incidentStartHeader"
                text="Started"/>
        </Column>

        <Column id="incidentEtrColumn">
            <Text
                id="incidentEtrHeader"
                text="ETR"/>
        </Column>

        <Column id="incidentStatusColumn">
            <Text
                id="incidentStatusHeader"
                text="Status"/>
        </Column>

    </columns>

    <items>

        <ColumnListItem id="incidentItem">

            <cells>

                <Text
                    id="incidentType"
                    text="{production>type}"/>

                <Text
                    id="incidentDescription"
                    text="{production>description}"/>

                <Text
                    id="incidentStart"
                    text="{production>startTime}"/>

                <Text
                    id="incidentEtr"
                    text="{production>etr}"/>

                <ObjectStatus
                    id="incidentStatus"
                    text="{production>status}"/>

            </cells>

        </ColumnListItem>

    </items>

</Table>


                <Title
                    id="updatesTitle"
                    text="2-Hour Production Updates"
                    level="H2"
                    class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>


                <Table
                    id="updatesTable"
                    items="{production>updates}">

                    <columns>

                        <Column id="updateTimeColumn">
                            <Text
                                id="updateTimeHeader"
                                text="Time"/>
                        </Column>

                        <Column id="periodProductionColumn">
                            <Text
                                id="periodProductionHeader"
                                text="Period Production"/>
                        </Column>

                        <Column id="cumulativeColumn">
                            <Text
                                id="cumulativeHeader"
                                text="Cumulative"/>
                        </Column>

                        <Column id="plannedColumn">
                            <Text
                                id="plannedHeader"
                                text="Planned"/>
                        </Column>

                        <Column id="varianceColumn">
                            <Text
                                id="varianceHeader"
                                text="Variance"/>
                        </Column>

                        <Column id="updateStatusColumn">
                            <Text
                                id="updateStatusHeader"
                                text="Status"/>
                        </Column>

       
                    </columns>


                    <items>

                        <ColumnListItem id="updateItem">

                            <cells>

                                <Text
                                    id="updateTime"
                                    text="{production>time}"/>

                                <ObjectNumber
                                    id="periodProduction"
                                    number="{production>periodProduction}"
                                    unit="L"/>

                                <ObjectNumber
                                    id="cumulativeProduction"
                                    number="{production>cumulativeProduction}"
                                    unit="L"/>

                                <ObjectNumber
                                    id="plannedProduction"
                                    number="{production>plannedProduction}"
                                    unit="L"/>

                               <ObjectNumber
    id="variance"
    number="{production>variance}"
    unit="L"
    state="{
        path: 'production>variance',
        formatter: '.getVarianceState'
    }"/>

                                <ObjectStatus
                                    id="updateStatus"
                                    text="{production>status}"/>

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

    </Page>

</mvc:View>