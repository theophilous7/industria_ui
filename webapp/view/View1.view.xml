<mvc:View
    controllerName="industriaui.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="productionPage"
        title="INDUSTRIA Production Control Center">

        <content>

            <VBox
                id="productionOverview"
                class="sapUiMediumMargin">

                <Title
                    id="overviewTitle"
                    text="Production Overview"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>

                <HBox
                    id="kpiContainer"
                    justifyContent="SpaceBetween"
                    wrap="Wrap">

                    <VBox
                        id="targetKpi"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <Title
                            id="targetKpiTitle"
                            text="Production Target"/>

                       <ObjectNumber
    id="targetKpiNumber"
    number="{production>/dashboard/target}"
    unit="L"/>

                    </VBox>

                    <VBox
                        id="producedKpi"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <Title
                            id="producedKpiTitle"
                            text="Produced"/>

                   <ObjectNumber
    id="producedKpiNumber"
    number="{production>/dashboard/produced}"
    unit="L"/>

                    </VBox>

                    <VBox
                        id="achievementKpi"
                        class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                        <Title
                            id="achievementKpiTitle"
                            text="Achievement"/>

                        <ObjectNumber
    id="achievementKpiNumber"
    number="{production>/dashboard/achievement}"
    unit="%"/>

                    </VBox>

                    <VBox
                        id="riskKpi"
                        class="sapUiSmallMarginBottom">

                        <Title
                            id="riskKpiTitle"
                            text="Orders At Risk"/>

                        <ObjectNumber
    id="riskKpiNumber"
    number="{production>/dashboard/ordersAtRisk}"/>

                    </VBox>

                </HBox>


                <Title
    id="ordersTitle"
    text="Production Orders"
    level="H2"
    class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>

<Table
    id="productionOrdersTable"
    items="{production>/orders}"
    growing="true"
    growingThreshold="10">

    <headerToolbar>
        <Toolbar id="ordersToolbar">
            <Title
                id="ordersTableTitle"
                text="Active Orders"/>
        </Toolbar>
    </headerToolbar>

    <columns>

        <Column id="orderColumn">
            <Text
                id="orderColumnText"
                text="Order"/>
        </Column>

        <Column id="skuColumn">
            <Text
                id="skuColumnText"
                text="SKU"/>
        </Column>

        <Column id="targetColumn">
            <Text
                id="targetColumnText"
                text="Target"/>
        </Column>

        <Column id="producedColumn">
            <Text
                id="producedColumnText"
                text="Produced"/>
        </Column>

        <Column id="statusColumn">
            <Text
                id="statusColumnText"
                text="Status"/>
        </Column>

    </columns>

    <items>

        <ColumnListItem id="productionOrderItem">

            <cells>

                <Text
                    id="orderNumber"
                    text="{production>orderId}"/>

                <Text
                    id="orderSku"
                    text="{production>sku}"/>

                <ObjectNumber
                    id="orderTarget"
                    number="{production>target}"
                    unit="L"/>

                <ObjectNumber
                    id="orderProduced"
                    number="{production>produced}"
                    unit="L"/>

                <ObjectStatus
                    id="orderStatus"
                    text="{production>status}"/>

            </cells>

        </ColumnListItem>

    </items>

</Table>
<Title
    id="linesTitle"
    text="Manufacturing Lines"
    level="H2"
    class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>

<Table
    id="productionLinesTable"
    items="{production>/productionLines}"
    growing="true"
    growingThreshold="10">

    <headerToolbar>
        <Toolbar id="linesToolbar">
            <Title
                id="linesTableTitle"
                text="Current Shift"/>
        </Toolbar>
    </headerToolbar>

    <columns>

        <Column id="lineColumn">
            <Text
                id="lineColumnText"
                text="Line"/>
        </Column>

        <Column id="lineSkuColumn">
            <Text
                id="lineSkuColumnText"
                text="SKU"/>
        </Column>

        <Column id="lineTargetColumn">
            <Text
                id="lineTargetColumnText"
                text="Shift Target"/>
        </Column>

        <Column id="lineProducedColumn">
            <Text
                id="lineProducedColumnText"
                text="Produced"/>
        </Column>

        <Column id="lineStatusColumn">
            <Text
                id="lineStatusColumnText"
                text="Status"/>
        </Column>

    </columns>

    <items>

     <ColumnListItem
    id="productionLineItem"
    type="Active"
    press=".onLinePress">

            <cells>

                <Text
                    id="lineName"
                    text="{production>lineName}"/>

                <Text
                    id="lineSku"
                    text="{production>sku}"/>

                <ObjectNumber
                    id="lineTarget"
                    number="{production>shiftTarget}"
                    unit="L"/>

                <ObjectNumber
                    id="lineProduced"
                    number="{production>produced}"
                    unit="L"/>

               <ObjectStatus
    id="lineStatus"
    text="{production>status}"
    state="{
        path: 'production>status',
        formatter: '.getStatusState'
    }"/>

            </cells>

        </ColumnListItem>

    </items>

</Table>
            </VBox>

        </content>

    </Page>

</mvc:View>