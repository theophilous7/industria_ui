<mvc:View
controllerName="industriaui.controller.OrderDetails"
xmlns:mvc="sap.ui.core.mvc"
xmlns="sap.m">

<Page
    id="orderDetailsPage"
    title="Production Order Details"
    showNavButton="true"
    navButtonPress=".onNavBack">

    <content>

        <VBox
            id="orderDetailsContainer"
            class="sapUiMediumMargin">

            <!-- ORDER HEADER -->

            <ObjectHeader
                id="orderDetailsHeader"
                title="{production>orderId}"
                intro="{production>sku}"
                number="{production>produced}"
                numberUnit="{production>unit}">

                <attributes>

                    <ObjectAttribute
                        id="orderTargetAttribute"
                        title="Target"
                        text="{production>target} {production>unit}"/>

                    <ObjectAttribute
                        id="orderDueDateAttribute"
                        title="Due Date"
                        text="{production>dueDate}"/>

                    <ObjectAttribute
                        id="orderPriorityAttribute"
                        title="Priority"
                        text="{production>priority}"/>

                </attributes>

                <statuses>

                    <ObjectStatus
                        id="orderDetailsStatus"
                        text="{production>status}"
                        state="{
                            path: 'production>status',
                            formatter: '.getStatusState'
                        }"/>

                </statuses>

            </ObjectHeader>
<Text
    id="debugOrderBinding"
    text="{= ${production>orderId} + ' | ' + ${production>sku} }"/>

            <!-- PRODUCTION PROGRESS -->

            <Title
                id="orderProgressTitle"
                text="Production Progress"
                level="H2"
                class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>

            <ProgressIndicator
                id="orderProgressIndicator"
                percentValue="{= ${production>produced} / ${production>target} * 100 }"
                displayValue="{= ${production>produced} + ' / ' + ${production>target} + ' ' + ${production>unit} }"
                state="{
                    path: 'production>status',
                    formatter: '.getStatusState'
                }"/>


            <!-- KEY INFORMATION -->

            <HBox
                id="orderInformationContainer"
                wrap="Wrap"
                justifyContent="SpaceBetween"
                class="sapUiMediumMarginTop">

                <VBox
                    id="orderTargetBox"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <Title
                        id="orderTargetLabel"
                        text="Target"/>

                    <ObjectNumber
                        id="orderTargetNumber"
                        number="{production>target}"
                        unit="{production>unit}"/>

                </VBox>


                <VBox
                    id="orderProducedBox"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <Title
                        id="orderProducedLabel"
                        text="Produced"/>

                    <ObjectNumber
                        id="orderProducedNumber"
                        number="{production>produced}"
                        unit="{production>unit}"/>

                </VBox>


                <VBox
                    id="orderRemainingBox"
                    class="sapUiSmallMarginEnd sapUiSmallMarginBottom">

                    <Title
                        id="orderRemainingLabel"
                        text="Remaining"/>

                    <ObjectNumber
                        id="orderRemainingNumber"
                        number="{= ${production>target} - ${production>produced} }"
                        unit="{production>unit}"/>

                </VBox>

            </HBox>


        <!-- MATERIAL READINESS -->

<Title
    id="orderMaterialsTitle"
    text="Material Readiness"
    level="H2"
    class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
    

<Table
    id="orderMaterialsTable"
items="{production>materials}"
    growing="true"
    growingThreshold="10"
>

<columns>

    <Column id="orderMaterialNameColumn">
        <Text
            id="orderMaterialNameHeader"
            text="Material"/>
    </Column>

    <Column id="orderMaterialRequiredColumn">
        <Text
            id="orderMaterialRequiredHeader"
            text="Required"/>
    </Column>

    <Column id="orderMaterialAvailableColumn">
        <Text
            id="orderMaterialAvailableHeader"
            text="Available"/>
    </Column>

    <Column id="orderMaterialStatusColumn">
        <Text
            id="orderMaterialStatusHeader"
            text="Status"/>
    </Column>

</columns>

<items>

    <ColumnListItem id="orderMaterialItem">

        <cells>

            <Text
                id="orderMaterialNameText"
                text="{production>material}"/>

            <ObjectNumber
                id="orderMaterialRequiredNumber"
                number="{production>required}"
                unit="{production>unit}"/>

            <ObjectNumber
                id="orderMaterialAvailableNumber"
                number="{production>available}"
                unit="{production>unit}"/>

            <ObjectStatus
    id="orderMaterialStatus"
    text="{production>status}"
    state="{
        path: 'production>status',
        formatter: '.getStatusState'
    }"/>

        </cells>

    </ColumnListItem>

</items>
       
</Table>

        </VBox>

    </content>

</Page>

</mvc:View>
